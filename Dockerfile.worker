# rag-platform — imagem do worker de indexação (RAG-072).
#
# Mesma estrutura de Dockerfile.api (mesmo racional documentado lá):
# build multi-stage, dependências de produção instaladas isoladas do
# código-fonte, usuário não-root, sem toolchain de build na imagem
# final. `config/` precisa ficar como irmão de `packages/` no
# filesystem final — `packages/config/models.py`/`packages/generation/
# prompts.py` resolvem o caminho via `Path(__file__).parent.parent.parent
# / "config"`, não via um pacote instalado — por isso é copiado
# diretamente para /app, nunca instalado via pip.
FROM python:3.12-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY pyproject.toml ./
RUN mkdir -p apps packages adapters \
    && touch apps/__init__.py packages/__init__.py adapters/__init__.py

RUN pip install --user --no-cache-dir .

FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local
COPY --chown=appuser:appuser apps ./apps
COPY --chown=appuser:appuser packages ./packages
COPY --chown=appuser:appuser adapters ./adapters
COPY --chown=appuser:appuser config ./config

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser

# Sem EXPOSE: o worker Celery não escuta porta nenhuma (consome a fila
# Redis configurada via Settings.redis_url, RAG-022).
CMD ["python", "-m", "celery", "-A", "apps.indexing_worker.worker", "worker", "--loglevel=info"]
