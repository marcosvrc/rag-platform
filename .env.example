# rag-platform — variáveis de ambiente de exemplo
#
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# A validação (nomes, tipos e obrigatoriedade) é feita por
# packages/config/settings.py (RAG-004) via Pydantic Settings — variáveis
# sem default ali (as senhas) são obrigatórias. Nunca copie valores reais
# de credenciais para este arquivo.

# Identificação do ambiente de execução (local | development | production).
ENVIRONMENT=local

# --- RAG-003: Docker Compose local (Postgres, Redis, MinIO, observabilidade) ---
# Credenciais abaixo são apenas defaults de DESENVOLVIMENTO LOCAL, usados
# pelo docker-compose.yml. Nunca reutilize estes valores em ambientes reais.

# PostgreSQL + pgvector
# POSTGRES_HOST=localhost é o valor certo quando a API/worker rodam no
# host (fora do Docker Compose); dentro da rede do compose seria "postgres".
POSTGRES_HOST=localhost
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=rag_platform_local_only
POSTGRES_DB=rag_platform
POSTGRES_PORT=5432

# Redis (fila/Celery)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (object storage compatível com S3)
MINIO_HOST=localhost
MINIO_ROOT_USER=rag_platform
MINIO_ROOT_PASSWORD=rag_platform_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=rag-platform

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889

# --- RAG-052: Tracing distribuído (API e worker) ---
# OTEL_TRACES_ENABLED liga a exportação real de traces (ver
# packages/observability/tracing.py) — sem essa variável (ou com
# qualquer valor diferente de true/1/yes), a instrumentação continua
# ativa, mas contra o tracer no-op padrão do OpenTelemetry: nenhum
# dado é exportado. Não é uma variável padrão do OpenTelemetry (ao
# contrário das duas abaixo, que o próprio SDK já lê sozinho).
OTEL_TRACES_ENABLED=true
# Endpoint OTLP/HTTP do Collector acima (lido pelo próprio SDK, não
# por Settings) — padrão do SDK já é http://localhost:4318/v1/traces,
# que bate com OTEL_HTTP_PORT; só defina se mudar a porta do Collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rag_platform_local_only
GRAFANA_PORT=3000

# --- RAG-021: Upload de documentos ---
# Tamanho máximo de arquivo aceito, em bytes (padrão: 50 MiB).
DOCUMENT_MAX_SIZE_BYTES=52428800
# --- RAG-050: Autenticação JWT ---
# Em modo local, isso é um provedor de identidade SIMULADO: só um segredo
# compartilhado (HS256), sem OIDC real. NUNCA reutilize JWT_SECRET (nem
# JWT_ISSUER/JWT_AUDIENCE) em development ou production — lá, use um
# algoritmo assimétrico (JWT_ALGORITHM=RS256 + JWT_PUBLIC_KEY com a chave
# pública do IdP real) e um segredo gerenciado por secret manager.
JWT_ALGORITHM=HS256
JWT_SECRET=local_only_dev_secret_do_not_reuse
JWT_ISSUER=rag-platform-local
JWT_AUDIENCE=rag-platform-api
JWT_LEEWAY_SECONDS=10

# --- RAG-025/RAG-030: Gateway de embeddings/geração LiteLLM ---
# Provisionado pelo docker-compose (serviços `litellm`+`ollama`, RAG-030
# — ver README, seção RAG-030): fora do docker-compose (rodando a API
# direto no host, `make run-api`), aponte para localhost:4000; dentro
# da rede do compose, use http://litellm:4000. LITELLM_API_KEY fica em
# branco por padrão (proxy local de desenvolvimento não exige
# autenticação); nunca deixe em branco em production.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_TIMEOUT_SECONDS=30
LITELLM_MAX_RETRIES=3
LITELLM_EMBEDDING_BATCH_SIZE=100
