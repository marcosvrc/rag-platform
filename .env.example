# rag-platform — variáveis de ambiente de exemplo
#
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# A validação (nomes, tipos e obrigatoriedade) é feita por
# packages/config/settings.py (RAG-004) via Pydantic Settings — variáveis
# sem default ali (as senhas) são obrigatórias. Nunca copie valores reais
# de credenciais para este arquivo.

# Identificação do ambiente de execução (local | development | production).
ENVIRONMENT=local

# --- RAG-003: Docker Compose local (Postgres, Redis, MinIO, observabilidade) ---
# Credenciais abaixo são apenas defaults de DESENVOLVIMENTO LOCAL, usados
# pelo docker-compose.yml. Nunca reutilize estes valores em ambientes reais.

# PostgreSQL + pgvector
# POSTGRES_HOST=localhost é o valor certo quando a API/worker rodam no
# host (fora do Docker Compose); dentro da rede do compose seria "postgres".
POSTGRES_HOST=localhost
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=rag_platform_local_only
POSTGRES_DB=rag_platform
POSTGRES_PORT=5432

# Redis (fila/Celery)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (object storage compatível com S3)
MINIO_HOST=localhost
MINIO_ROOT_USER=rag_platform
MINIO_ROOT_PASSWORD=rag_platform_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=rag-platform

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rag_platform_local_only
GRAFANA_PORT=3000

# --- RAG-021: Upload de documentos ---
# Tamanho máximo de arquivo aceito, em bytes (padrão: 50 MiB).
DOCUMENT_MAX_SIZE_BYTES=52428800
